#!/usr/bin/env bash
# gtvpn-xpra-proxy: the xpra viewer on your computer reaches its session on
# a GT server through here. The viewer runs `ssh gtvpn` (the container's
# key-only, loopback sshd) with this program, through a link named after
# the GT server (~/.gtvpn/xpra/<host>, made by gtvpn-xpra), as its "remote
# xpra":
#     <link> _proxy :N
# and this relays that channel over the container's shared connection to
# `xpra _proxy :N` on the server. Nothing listens anywhere, and no new
# sign-in happens: without an open connection it fails at once.
set -uo pipefail
host=$(basename "$0")
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ && $host != gtvpn-xpra-proxy ]] \
  || { echo "gtvpn-xpra-proxy: run it through a host link made by gtvpn-xpra" >&2; exit 2; }
[[ ${1:-} == _proxy && ${2:-} =~ ^:[0-9]+$ ]] \
  || { echo "gtvpn-xpra-proxy: expected '_proxy :N', got: $*" >&2; exit 2; }
# shellcheck disable=SC2088  # ssh expands the ~
if ! ssh -o ControlPath='~/.ssh/cm-%C' -O check "$host" >/dev/null 2>&1; then
  echo "gtvpn: no open connection to $host from the container. On your computer run: gtvpn xpra $host" >&2
  exit 1
fi
# shellcheck disable=SC2088,SC2016  # expanded by ssh / on the server
exec ssh -o ControlPath='~/.ssh/cm-%C' -o ControlMaster=no -o BatchMode=yes -o ForwardX11=no \
  -o LogLevel=error -T "$host" \
  "exec /bin/sh -c 'exec \"\$HOME/.local/gtvpn-xpra/env/bin/xpra\" _proxy $2 --socket-dirs=\"\$HOME/.xpra\"'"
