#!/usr/bin/env bash
# gtvpn-verify: prove, from inside the container, that
#   (a) the tunnel works for your tools (when connected), and
#   (b) nothing your tools do can leave the container except through the
#       tunnel, and nothing reaches the Docker host / your LAN.
#
# Every leak test is checked two ways: the connection must fail AND the
# kill-switch's reject counter must go up, which proves it was the firewall
# that stopped it (not just a missing route or a down server).
#
#   gtvpn-verify            --full if the tunnel is up, else --pre
#   gtvpn-verify --pre      leak tests only (no tunnel expected)
#   gtvpn-verify --full     leak tests + tunnel reachability tests
#   gtvpn-verify --loop N   repeat every N seconds until a failure (Ctrl-C to stop)
#   --quiet                 print only failures
#
# Config (env): GTVPN_PROBE_TARGETS="host:port ..." (GT hosts that must be
# reachable through the tunnel), GTVPN_PROBE_NAMES="name ..." (must resolve
# via the tunnel DNS), GTVPN_EGRESS_URL (optional what-is-my-IP URL).
set -uo pipefail
[[ $(id -u) == 0 ]] || exec echo "gtvpn-verify must run as root (gtvpn verify does this for you)"

MODE=auto; QUIET=0; LOOP=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --pre) MODE=pre ;; --full) MODE=full ;; --quiet) QUIET=1 ;;
    --loop) LOOP=${2:?}; shift ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac; shift
done

TUN=${GTVPN_TUN_IF:-tun0}
WAN=$(cat /run/gtvpn/wan_if 2>/dev/null || echo eth0)
PUBLIC_V4=${GTVPN_TEST_PUBLIC_V4:-1.1.1.1}
PUBLIC_V4B=${GTVPN_TEST_PUBLIC_V4B:-8.8.8.8}
LAN_V4=${GTVPN_TEST_LAN_V4:-192.168.1.1}
PUBLIC_V6=${GTVPN_TEST_PUBLIC_V6:-2606:4700:4700::1111}

asdev()   { setpriv --reuid=dev --regid=dev --init-groups -- "$@"; }
asroot0() { setpriv --regid=0 --clear-groups -- "$@"; }          # root, but not the VPN client
asvpn()   { setpriv --regid=gpvpn --clear-groups -- "$@"; }      # the VPN client identity
blocked() { iptables -w 5 -nvxL GTVPN_BLOCKED 2>/dev/null | awk 'NR>2{s+=$1}END{print s+0}'; }
route_dev() { ip -4 route get "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'; }

FAILS=0; PASSES=0; REPORT=""
emit() { # status id text
  local line; line=$(printf '%-4s %-4s %s' "$1" "$2" "$3")
  REPORT+="$line"$'\n'
  [[ $1 == FAIL ]] && FAILS=$((FAILS+1))
  [[ $1 == PASS ]] && PASSES=$((PASSES+1))
  if [[ $QUIET == 0 || $1 == FAIL ]]; then
    case $1 in PASS) c=32;; FAIL) c=31;; *) c=33;; esac
    printf '\033[%sm%s\033[0m\n' "$c" "$line"
  fi
}

# must_block ID DESC -- cmd...   : cmd must fail and the reject counter must rise
must_block() {
  local id=$1 desc=$2; shift 3
  local before after
  before=$(blocked)
  if "$@" >/dev/null 2>&1; then
    emit FAIL "$id" "$desc  (connection SUCCEEDED: leak)"
    return
  fi
  after=$(blocked)
  if (( after > before )); then emit PASS "$id" "$desc"
  else emit FAIL "$id" "$desc  (failed, but not by the kill-switch: check routing)"; fi
}
# must_work ID DESC -- cmd...
must_work() {
  local id=$1 desc=$2; shift 3
  if "$@" >/dev/null 2>&1; then emit PASS "$id" "$desc"; else emit FAIL "$id" "$desc"; fi
}


run_pre() {
  # Static state
  if /usr/local/sbin/gtvpn-firewall check >/dev/null 2>&1; then emit PASS F1 "kill-switch ruleset intact, policy DROP on INPUT/OUTPUT/FORWARD"
  else emit FAIL F1 "kill-switch ruleset missing or modified"; fi
  if [[ ! -d /proc/sys/net/ipv6 ]]; then emit PASS F2 "IPv6 not present in this kernel"
  elif [[ $(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null) == 1 ]]; then emit PASS F2 "IPv6 disabled in the container"
  else emit FAIL F2 "IPv6 is enabled in the container"; fi
  if ip6tables -S 2>/dev/null | grep -qx -- '-P OUTPUT DROP'; then emit PASS F3 "IPv6 output policy DROP"
  else emit INFO F3 "ip6tables not available (IPv6 disabled by sysctl only)"; fi
  local weak; weak=$(/usr/local/sbin/gtvpn-permcheck | head -5 | tr '\n' ' ')
  if [[ -z $weak ]]; then emit PASS F4 "root-run scripts and their directories are root-owned and not writable by dev"
  else emit FAIL F4 "writable by non-root (privilege-escalation path): $weak"; fi
  if [[ ! -e /.dockerenv && -z ${container:-} ]]; then emit INFO F4 "could not confirm we are in a container"; fi

  local gw; gw=$(cat /run/gtvpn/wan_gw 2>/dev/null)

  # Your tools (user dev) must not get out of the WAN interface
  if [[ $(route_dev "$PUBLIC_V4") == "$WAN" ]]; then
    must_block L1 "dev -> internet $PUBLIC_V4:443 outside tunnel is blocked" -- asdev nc -z -n -w 3 "$PUBLIC_V4" 443
    must_block L2 "dev -> internet DNS $PUBLIC_V4B:53 outside tunnel is blocked" -- asdev dig +time=2 +tries=1 @"$PUBLIC_V4B" gatech.edu A
    must_block L3 "dev -> ping $PUBLIC_V4 outside tunnel is blocked" -- asdev ping -n -c1 -W2 "$PUBLIC_V4"
  else
    emit INFO L1 "internet is routed via the tunnel (full-tunnel VPN); direct-path tests use the gateway below"
  fi
  must_block L4 "dev -> Docker DNS 127.0.0.11 is blocked (no DNS leak to host resolver)" -- asdev dig +time=2 +tries=1 @127.0.0.11 gatech.edu A
  if [[ -n $gw ]]; then
    must_block L5 "dev -> Docker host/gateway $gw:22 is blocked" -- asdev nc -z -n -w 3 "$gw" 22
    must_block L6 "dev -> Docker host/gateway $gw:2375 is blocked" -- asdev nc -z -n -w 3 "$gw" 2375
    must_block L7 "VPN client -> Docker host/gateway $gw:443 is blocked (private range)" -- asvpn nc -z -n -w 3 "$gw" 443
  fi
  if [[ $(route_dev "$LAN_V4") == "$WAN" ]]; then
    must_block L8 "dev -> home LAN $LAN_V4:80 is blocked" -- asdev nc -z -n -w 3 "$LAN_V4" 80
    must_block L9 "VPN client -> home LAN $LAN_V4:443 is blocked" -- asvpn nc -z -n -w 3 "$LAN_V4" 443
  fi
  if [[ $(route_dev "$PUBLIC_V4") == "$WAN" ]]; then
    must_block L10 "root (not VPN client) -> $PUBLIC_V4:443 is blocked" -- asroot0 nc -z -n -w 3 "$PUBLIC_V4" 443
    must_block L11 "VPN client -> $PUBLIC_V4:80 (non-VPN port) is blocked" -- asvpn nc -z -n -w 3 "$PUBLIC_V4" 80
  fi
  if asdev timeout 5 nc -6 -z -n -w 3 "$PUBLIC_V6" 443 >/dev/null 2>&1; then emit FAIL L12 "dev -> IPv6 internet SUCCEEDED (leak)"
  else emit PASS L12 "dev -> IPv6 internet is impossible"; fi
  # Control: the VPN client itself must still be able to reach the portal,
  # otherwise the blocks above prove nothing about selectivity.
  if [[ ${GTVPN_SKIP_CONTROL:-0} != 1 ]]; then
    local pip; pip=$(asvpn timeout 5 getent ahostsv4 "${GTVPN_PORTAL:-vpn.gatech.edu}" 2>/dev/null | awk 'NR==1{print $1}')
    if [[ -n $pip ]] && asvpn nc -z -n -w 4 "$pip" 443 >/dev/null 2>&1; then
      emit PASS C1 "VPN client can reach portal ${GTVPN_PORTAL:-vpn.gatech.edu} ($pip:443) - firewall is selective, not just closed"
    else
      emit INFO C1 "VPN client cannot reach portal ${GTVPN_PORTAL:-vpn.gatech.edu}:443 right now (offline? captive portal?)"
    fi
  fi
  if ! ip link show "$TUN" >/dev/null 2>&1; then
    if asdev timeout 5 getent ahostsv4 "${GTVPN_PORTAL:-vpn.gatech.edu}" >/dev/null 2>&1; then
      emit FAIL L13 "dev can resolve names with no tunnel (DNS leak)"
    else emit PASS L13 "dev cannot resolve any name while disconnected"; fi
  fi
}

# proxy_refuses ID DESC HOST PORT : the egress proxy must answer CONNECT with 403
proxy_refuses() {
  local code
  code=$(asdev curl -s -o /dev/null -w '%{http_connect}' -m 10 -x "$PROXY" "https://$3:$4/" 2>/dev/null || true)
  if [[ $code == 403 ]]; then emit PASS "$1" "$2"
  else emit FAIL "$1" "$2  (proxy answered '${code:-nothing}', expected 403)"; fi
}

run_egress() {
  if [[ ${GTVPN_DIRECT_EGRESS:-1} != 1 ]]; then emit INFO E0 "direct egress disabled: the container can only use the tunnel"; return; fi
  PROXY=http://127.0.0.1:${GTVPN_PROXY_PORT:-3128}
  local port=${GTVPN_PROXY_PORT:-3128} first ip code
  if ! ss -ltnH "sport = :$port" | grep -q .; then emit FAIL E1 "egress proxy is not running"; return; fi
  if ss -ltnH "sport = :$port" | awk '{print $4}' | grep -qv '^127\.0\.0\.1:'; then emit FAIL E1 "egress proxy listens beyond loopback"
  else emit PASS E1 "egress proxy listens on 127.0.0.1 only"; fi

  first=$(awk '{print $1}' <<<"${GTVPN_DIRECT_ALLOW:-api.anthropic.com}")
  code=$(asdev curl -s -o /dev/null -w '%{http_code}' -m 15 -x "$PROXY" "https://$first/" 2>/dev/null || true)
  if [[ -n $code && $code != 000 ]]; then emit PASS E2 "allow-listed $first reachable via the direct path (HTTP $code)"
  else emit INFO E2 "allow-listed $first not reachable right now (offline?)"; fi

  proxy_refuses E3 "proxy refuses a non-allow-listed site (example.com)" example.com 443
  proxy_refuses E4 "proxy refuses the GT portal ${GTVPN_PORTAL:-vpn.gatech.edu} (GT only via tunnel)" "${GTVPN_PORTAL:-vpn.gatech.edu}" 443
  proxy_refuses E5 "proxy refuses gatech.edu (GT only via tunnel)" gatech.edu 443
  proxy_refuses E6 "proxy refuses raw IP destinations ($PUBLIC_V4)" "$PUBLIC_V4" 443
  proxy_refuses E7 "proxy refuses non-443 ports ($first:22)" "$first" 22

  ip=$(awk -v h="$first" '$2==h{print $1; exit}' /etc/hosts)
  if [[ -n $ip ]]; then
    emit PASS E8 "$first pinned to $ip from Docker DNS (lookup never sent to GT)"
    if [[ $(ip -4 route get "$ip" mark 0x1a6 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}') == "$WAN" ]]; then
      emit PASS E9 "proxy traffic to $ip is policy-routed via $WAN, never the GT tunnel"
    else emit FAIL E9 "proxy traffic to $ip would not leave via $WAN"; fi
    if [[ $(route_dev "$ip") == "$WAN" ]]; then
      must_block E10 "dev -> $first ($ip:443) bypassing the proxy is blocked" -- asdev nc -z -n -w 3 "$ip" 443
    else
      emit INFO E10 "$ip is routed via the tunnel for non-proxy traffic (full-tunnel)"
    fi
  else
    emit INFO E8 "$first not pinned yet (offline?)"
  fi
  if awk '/>>> gtvpn direct-egress/{f=1;next} /<<< gtvpn direct-egress/{f=0} f' /etc/hosts | grep -qi 'gatech' \
     || grep -qi 'gatech' /run/gtvpn/egress-allow.ere 2>/dev/null; then
    emit FAIL E11 "a GT hostname is on the direct-egress allow-list"
  else emit PASS E11 "no GT hostname is on the direct-egress allow-list"; fi
}

run_full() {
  if ! ip -4 addr show "$TUN" 2>/dev/null | grep -q inet; then
    emit FAIL T1 "tunnel $TUN is not up"; return
  fi
  emit PASS T1 "tunnel $TUN is up ($(ip -4 -o addr show "$TUN" | awk '{print $4}'))"

  local full=0
  [[ $(ip -4 route show default | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}') == "$TUN" ]] && full=1
  ip -4 route | grep -q "^0.0.0.0/1 .*dev $TUN" && full=1
  if [[ $full == 1 ]]; then emit INFO T2 "full-tunnel: all container traffic goes to GT"
  else emit INFO T2 "split-tunnel: only GT routes go through the tunnel; everything else is blocked"; fi

  # DNS servers must be reachable only through the tunnel
  local ns nsdev any=0
  for ns in $(awk '/^nameserver/{print $2}' /etc/resolv.conf); do
    any=1
    [[ $ns == 127.0.0.11 ]] && { emit FAIL T3 "resolv.conf still points at Docker DNS (VPN DNS not applied)"; continue; }
    nsdev=$(route_dev "$ns")
    if [[ $nsdev == "$TUN" ]]; then emit PASS T3 "DNS server $ns is routed through the tunnel"
    else emit FAIL T3 "DNS server $ns is routed via '$nsdev', not the tunnel"; fi
  done
  [[ $any == 1 ]] || emit FAIL T3 "no DNS servers configured"

  local n
  for n in ${GTVPN_PROBE_NAMES:-gatech.edu}; do
    must_work T4 "dev resolves $n via tunnel DNS" -- asdev timeout 10 getent ahostsv4 "$n"
  done

  local t h p ip
  for t in ${GTVPN_PROBE_TARGETS:-}; do
    h=${t%:*}; p=${t##*:}
    ip=$(asdev getent ahostsv4 "$h" 2>/dev/null | awk 'NR==1{print $1}')
    if [[ -z $ip ]]; then emit FAIL T5 "cannot resolve probe target $h"; continue; fi
    if [[ $(route_dev "$ip") != "$TUN" ]]; then emit FAIL T5 "$h ($ip) is NOT routed through the tunnel"; continue; fi
    must_work T5 "dev -> $h:$p ($ip) reachable through tunnel" -- asdev nc -z -n -w 3 "$ip" "$p"
  done
  [[ -z ${GTVPN_PROBE_TARGETS:-} ]] && emit SKIP T5 "set GTVPN_PROBE_TARGETS in .env (e.g. your Cadence server:22) to test reachability"

  # The VPN gateway itself is reachable over the WAN: only the VPN client may use it.
  local gwip
  for gwip in $(ip -4 route show dev "$WAN" | awk '$1 ~ /^[0-9.]+$/ && $1 !~ /\/[0-9]+$/ {print $1}'); do
    must_block T6 "dev -> VPN gateway $gwip:443 directly (outside tunnel) is blocked" -- asdev nc -z -n -w 3 "$gwip" 443
    must_block T7 "root (not VPN client) -> VPN gateway $gwip:443 is blocked" -- asroot0 nc -z -n -w 3 "$gwip" 443
  done

  if [[ -n ${GTVPN_EGRESS_URL:-} ]]; then
    local eip; eip=$(asdev curl -fsS -m 10 "$GTVPN_EGRESS_URL" 2>/dev/null | tr -dc '0-9a-fA-F.:' | head -c 64)
    if [[ -n $eip ]]; then emit INFO T8 "container egress IP: $eip"; echo "$eip" | /usr/local/sbin/gtvpn-outwrite egress_ip
    else emit INFO T8 "egress URL not reachable from container (expected with split-tunnel)"; rm -f /run/gtvpn/out/egress_ip; fi
  fi
}

once() {
  FAILS=0; PASSES=0; REPORT=""
  local m=$MODE
  [[ $m == auto ]] && { ip link show "$TUN" >/dev/null 2>&1 && m=full || m=pre; }
  [[ $QUIET == 0 ]] && printf '\033[1m== gtvpn container verification (%s) %s ==\033[0m\n' "$m" "$(date -u +%FT%TZ)"
  run_pre
  run_egress
  [[ $m == full ]] && run_full
  local summary="$PASSES passed, $FAILS failed (mode=$m)"
  [[ $QUIET == 0 ]] && printf '\033[1m== %s ==\033[0m\n' "$summary"
  { echo "# $(date -u +%FT%TZ) $summary"; printf '%s' "$REPORT"; } | /usr/local/sbin/gtvpn-outwrite verify.txt 2>/dev/null || true
  return $(( FAILS > 0 ))
}

if [[ $LOOP -gt 0 ]]; then
  n=0
  while once; do n=$((n+1)); [[ $QUIET == 1 ]] && echo "round $n ok"; sleep "$LOOP"; done
  exit 1
fi
once
