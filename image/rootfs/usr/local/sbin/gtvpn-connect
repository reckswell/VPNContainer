#!/usr/bin/env bash
# gtvpn-connect: sign in to the GlobalProtect portal and bring the tunnel up.
#
# SSO (SAML + Duo) flow, for portals that use it:
#   1. gpauth asks the portal for the SAML login URL.
#   2. The URL is handed to the host (runtime/out/login.url); the host-side
#      `gtvpn connect` opens it in your normal browser. You log in with
#      GT credentials + Duo there.
#   3. At the end the browser is sent to a "globalprotectcallback:..." link.
#      If the gtvpn link handler is installed it is delivered straight back
#      into this container; otherwise copy it and paste it here.
#   4. gpclient uses the resulting cookie to connect. The tunnel lives only
#      in this container's network namespace.
#
# Password flow, which is what Georgia Tech uses: gpclient prompts for
# user/password and the Duo second factor (type "push") in this terminal.
set -euo pipefail
[[ $(id -u) == 0 ]] || { echo "run as root: docker exec -it -u root gtvpn gtvpn-connect" >&2; exit 1; }

# Keep a transcript of this sign-in (what the terminal showed), so an error
# is not lost when the window closes: /var/log/gtvpn/connect.log, root-only,
# replaced each time (`gtvpn logs` shows it). `script` records output only,
# and the password and Duo prompts do not echo, so neither is in it.
TRANSCRIPT=/var/log/gtvpn/connect.log
if [[ -z ${GTVPN_IN_TRANSCRIPT:-} && -t 0 && -t 1 ]] && command -v script >/dev/null; then
  rm -f "$TRANSCRIPT"; install -m 0600 /dev/null "$TRANSCRIPT"
  SHELL=/bin/bash GTVPN_IN_TRANSCRIPT=1 exec script -qefc "$(printf '%q ' "$0" "$@")" "$TRANSCRIPT"
fi

PORTAL=${GTVPN_PORTAL:-vpn.gatech.edu}
AUTH=${GTVPN_AUTH:-auto}
OUT=/run/gtvpn/out
CB=/run/gtvpn/callback
TUN=${GTVPN_TUN_IF:-tun0}
LOGIN_TIMEOUT=${GTVPN_LOGIN_TIMEOUT:-300}
LOG=/var/log/gtvpn/gpclient.log

say() { printf '\033[1m[gtvpn]\033[0m %s\n' "$*"; }
die() { printf '\033[31m[gtvpn] %s\033[0m\n' "$*" >&2; exit 1; }
# Run as root with primary group gpvpn: the only identity the kill-switch
# lets out of the WAN interface (and only to the VPN control ports).
as_vpn() { setpriv --regid=gpvpn --clear-groups -- "$@"; }

if ip link show "$TUN" >/dev/null 2>&1; then
  say "already connected ($TUN is up). Use 'gtvpn disconnect' first to reconnect."
  exit 0
fi
/usr/local/sbin/gtvpn-firewall check >/dev/null || die "kill-switch is not intact; refusing to connect"
# Clear any half-dead previous session (stale client, missing default route).
/usr/local/sbin/gtvpn-disconnect >/dev/null 2>&1 || true

# gpclient takes --fix-openssl before the subcommand (gpauth takes it anywhere).
gp_global=()
[[ ${GTVPN_FIX_OPENSSL:-0} == 1 ]] && gp_global+=(--fix-openssl)
common=(-i "$TUN" --disable-ipv6)
[[ -n ${GTVPN_GATEWAY:-} ]] && common+=(-g "$GTVPN_GATEWAY") || common+=(--auto-gateway)
[[ ${GTVPN_HIP:-0} == 1 ]] && common+=(--hip)
[[ -n ${GTVPN_OS:-} ]] && common+=(--os "$GTVPN_OS")
[[ -n ${GTVPN_CLIENT_VERSION:-} ]] && common+=(--client-version "$GTVPN_CLIENT_VERSION")
# shellcheck disable=SC2206
[[ -n ${GTVPN_CLIENT_ARGS:-} ]] && common+=($GTVPN_CLIENT_ARGS)
auth_args=()
# shellcheck disable=SC2206
[[ -n ${GTVPN_AUTH_ARGS:-} ]] && auth_args+=($GTVPN_AUTH_ARGS)
[[ ${GTVPN_FIX_OPENSSL:-0} == 1 ]] && auth_args+=(--fix-openssl)
[[ -n ${GTVPN_OS:-} ]] && auth_args+=(--os "$GTVPN_OS")
[[ -n ${GTVPN_CLIENT_VERSION:-} ]] && auth_args+=(--client-version "$GTVPN_CLIENT_VERSION")

# ---- detect auth method -----------------------------------------------------
if [[ $AUTH == auto ]]; then
  pre=$(as_vpn curl -sS -m 20 -X POST \
        "https://$PORTAL/global-protect/prelogin.esp?tmp=tmp&clientVer=4100&clientos=Linux&default-browser=1&cas-support=yes" \
        2>/dev/null || true)
  if grep -q '<saml-auth-method>' <<<"$pre"; then AUTH=saml
  elif grep -q '<prelogin-response>' <<<"$pre"; then AUTH=password
  else say "could not reach $PORTAL for auto-detection; assuming SSO"; AUTH=saml
  fi
  say "portal $PORTAL uses ${AUTH^^} sign-in"
fi

rm -f "$OUT"/login.url "$OUT"/login.html "$CB"
# gpclient --background refuses a log file other users can read or write.
rm -f "$LOG"; install -m 0600 /dev/null "$LOG"

if [[ $AUTH == password ]]; then
  say "password sign-in (for Duo, enter e.g. 'push' at the second prompt)"
  as_vpn gpclient "${gp_global[@]}" connect "$PORTAL" ${GTVPN_USER:+-u "$GTVPN_USER"} "${common[@]}" \
    --background --log-file "$LOG"
else
  work=$(mktemp -d /run/gtvpn/auth.XXXXXX); chmod 700 "$work"
  cleanup() {
    exec 3>&- 2>/dev/null || true
    [[ -n ${reader:-} ]] && kill "$reader" 2>/dev/null || true
    [[ -n ${gpid:-} ]] && kill "$gpid" 2>/dev/null || true
    rm -rf "$work"; rm -f "$OUT"/login.url "$OUT"/login.html "$CB"
  }
  trap cleanup EXIT
  mkfifo "$work/in"
  as_vpn gpauth "$PORTAL" --browser manual --browser-listen 127.0.0.1 "${auth_args[@]}" \
    <"$work/in" >"$work/auth.json" 2>"$work/auth.log" &
  gpid=$!
  exec 3>"$work/in"

  url=""
  for _ in $(seq 60); do
    url=$(grep -ao 'http://127\.0\.0\.1:[0-9]*/[0-9a-fA-F-]*' "$work/auth.log" | head -1 || true)
    [[ -n $url ]] && break
    kill -0 "$gpid" 2>/dev/null || break
    sleep 0.5
  done
  [[ -n $url ]] || { sed 's/\x1b\[[0-9;]*m//g' "$work/auth.log" | tail -20 >&2; die "gpauth did not produce a login URL"; }

  # The local URL is a one-shot redirect (or auto-submitting form) to the
  # identity provider. Resolve it here so the host browser never needs to
  # reach into the container.
  loc=$(curl -sS -m 10 -o "$work/page" -w '%{redirect_url}' "$url" || true)
  umask 022
  if [[ -n $loc ]]; then
    printf '%s\n' "$loc" | /usr/local/sbin/gtvpn-outwrite login.url
    esc=${loc//&/&amp;}; esc=${esc//\"/&quot;}
    printf '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=%s"><title>GT VPN sign-in</title><a href="%s">Continue to sign-in</a>\n' "$esc" "$esc" | /usr/local/sbin/gtvpn-outwrite login.html
  elif grep -qi '<form' "$work/page"; then
    /usr/local/sbin/gtvpn-outwrite login.html < "$work/page"
    printf 'file:login.html\n' | /usr/local/sbin/gtvpn-outwrite login.url
  else
    die "unexpected response from gpauth's login server"
  fi

  say "Sign in with your GT account + Duo in the browser window that opens."
  [[ -n $loc ]] && say "If no browser opens, visit:" && printf '\n  %s\n\n' "$loc"
  say "When done, the browser hands back a 'globalprotectcallback:' link. With the"
  say "gtvpn link handler installed this is automatic; otherwise copy that link"
  say "(Firefox: from the address bar; Chrome/Edge: from the 'Open xdg-open?'/"
  say "'Open app?' prompt or DevTools > Network) and paste it here, then Enter."

  if [[ -t 0 ]]; then
    ( IFS= read -r line && printf '%s\n' "$line" > "$work/pasted" ) &
    reader=$!
  fi

  data=""; t0=$SECONDS
  while (( SECONDS - t0 < LOGIN_TIMEOUT )); do
    kill -0 "$gpid" 2>/dev/null || break
    if [[ -s $CB ]]; then data=$(head -c 65536 "$CB"); rm -f "$CB"; say "received sign-in from the browser handler"; fi
    if [[ -z $data && -s $work/pasted ]]; then data=$(cat "$work/pasted"); fi
    if [[ -n $data ]]; then
      data=$(printf '%s' "$data" | tr -d '\r\n[:space:]')
      if [[ $data == globalprotectcallback:* ]]; then break; fi
      say "that does not start with 'globalprotectcallback:'; try again"; data=""
      rm -f "$work/pasted"
      [[ -t 0 ]] && { ( IFS= read -r line && printf '%s\n' "$line" > "$work/pasted" ) & reader=$!; }
    fi
    sleep 0.5
  done
  [[ -n $data ]] || die "timed out waiting for the sign-in callback"
  printf '%s\n' "$data" >&3; exec 3>&-
  [[ -n ${reader:-} ]] && kill "$reader" 2>/dev/null || true
  rm -f "$OUT"/login.url "$OUT"/login.html

  wait "$gpid" || { sed 's/\x1b\[[0-9;]*m//g' "$work/auth.log" | tail -20 >&2; die "gpauth failed"; }
  gpid=""
  grep -q '"success"' "$work/auth.json" || die "sign-in was not accepted: $(head -c 300 "$work/auth.json")"
  say "signed in; starting tunnel"
  as_vpn gpclient "${gp_global[@]}" connect "$PORTAL" --cookie-on-stdin "${common[@]}" \
    --background --log-file "$LOG" <"$work/auth.json"
fi

say "waiting for $TUN"
for _ in $(seq 60); do
  ip -4 addr show "$TUN" 2>/dev/null | grep -q inet && break
  sleep 1
done
ip -4 addr show "$TUN" 2>/dev/null | grep -q inet || { tail -30 "$LOG" >&2; die "tunnel did not come up (log: $LOG)"; }
say "tunnel is up: $(ip -4 -o addr show "$TUN" | awk '{print $4}')"
echo
/usr/local/bin/gtvpn-verify --full || say "verification reported problems (see above)"
