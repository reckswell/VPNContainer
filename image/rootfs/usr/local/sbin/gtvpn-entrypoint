#!/usr/bin/env bash
# Container PID 1 (under docker-init). Order matters: the kill-switch goes up
# before anything else runs, and the container refuses to start if the
# pre-connect leak self-test fails.
set -euo pipefail

log() { printf '[gtvpn] %s\n' "$*" >&2; }
IN=/run/gtvpn/in       # read-only from host: authorized_keys, xauth
OUT=/run/gtvpn/out     # host-visible: login page/url for the SSO step
mkdir -p /run/gtvpn /var/log/gtvpn "$OUT" 2>/dev/null || true

# 1. Kill-switch -------------------------------------------------------------
/usr/local/sbin/gtvpn-firewall apply
cp /etc/resolv.conf /run/gtvpn/resolv.conf.orig

# 2. dev user matches the host user (so the X11 cookie file is readable) ----
HOST_UID=${HOST_UID:-1000}; HOST_GID=${HOST_GID:-1000}
if [[ $(id -u dev) != "$HOST_UID" || $(id -g dev) != "$HOST_GID" ]]; then
  if [[ $HOST_UID == 0 ]]; then log "HOST_UID=0 is not allowed"; exit 1; fi
  existing=$(getent group "$HOST_GID" | cut -d: -f1 || true)
  if [[ -z $existing ]]; then groupmod -g "$HOST_GID" dev; elif [[ $existing != dev ]]; then usermod -g "$HOST_GID" dev; fi
  usermod -u "$HOST_UID" dev
  chown -R dev: /home/dev 2>/dev/null || true
fi
chown dev: /home/dev

# 3. Session environment: X11 display, and the direct-egress proxy ----------
DISPLAY_VAL=${GTVPN_DISPLAY:-:0}
SESSION_ENV=(DISPLAY="$DISPLAY_VAL" GTVPN=1)
if [[ -s $IN/xauth ]]; then
  # The host hands us a wildcard-family cookie. ssh's X11 forwarding looks
  # cookies up by "<hostname>/unix:<n>", so give dev a private Xauthority
  # with both forms (fixes "Invalid MIT-MAGIC-COOKIE-1" over ssh -X/-Y).
  cookie=$(xauth -i -f "$IN/xauth" nlist 2>/dev/null | awk 'NR==1{print $NF}' || true)
  XA=/home/dev/.Xauthority
  rm -f "$XA"; install -m 600 -o dev -g dev /dev/null "$XA"
  if [[ $cookie =~ ^[0-9a-fA-F]+$ ]]; then
    setpriv --reuid=dev --regid=dev --init-groups -- sh -c \
      "xauth -q -f '$XA' add '$(hostname)/unix$DISPLAY_VAL' MIT-MAGIC-COOKIE-1 '$cookie' && xauth -q -f '$XA' merge '$IN/xauth'" || true
  fi
  SESSION_ENV+=(XAUTHORITY="$XA")
fi
if [[ ${GTVPN_DIRECT_EGRESS:-1} == 1 ]]; then
  P="http://127.0.0.1:${GTVPN_PROXY_PORT:-3128}"
  # GT names/ranges never use the proxy (the proxy would refuse them anyway);
  # they go straight into the tunnel.
  NP="localhost,127.0.0.1,.gatech.edu,gatech.edu,${GTVPN_NO_PROXY_EXTRA:-}10.0.0.0/8,128.61.0.0/16,130.207.0.0/16,143.215.0.0/16"
  SESSION_ENV+=(HTTPS_PROXY="$P" https_proxy="$P" NO_PROXY="$NP" no_proxy="$NP" DISABLE_AUTOUPDATER=1)
fi
{ for kv in "${SESSION_ENV[@]}"; do printf 'export %q\n' "$kv"; done; } > /etc/profile.d/gtvpn.sh
# Interactive non-login shells (VS Code terminals) too.
grep -q gtvpn.sh /etc/bash.bashrc || echo '[ -r /etc/profile.d/gtvpn.sh ] && . /etc/profile.d/gtvpn.sh' >> /etc/bash.bashrc

# ssh aliases for your GT hosts (from GTVPN_SSH_HOSTS="alias=host ...").
{
  echo "# Generated from GTVPN_SSH_HOSTS / GTVPN_GT_USER at container start."
  for pair in ${GTVPN_SSH_HOSTS:-}; do
    a=${pair%%=*}; h=${pair#*=}
    [[ $a =~ ^[A-Za-z0-9._-]+$ && $h =~ ^[A-Za-z0-9.-]+$ && $a != "$pair" ]] || continue
    printf 'Host %s\n    HostName %s\n' "$a" "$h"
    [[ -n ${GTVPN_GT_USER:-} && ${GTVPN_GT_USER} =~ ^[A-Za-z0-9._-]+$ ]] && printf '    User %s\n' "$GTVPN_GT_USER"
    printf '    ForwardX11 yes\n    ForwardX11Trusted yes\n    Compression yes\n'
    printf '    ControlMaster auto\n    ControlPath ~/.ssh/cm-%%C\n    ControlPersist 8h\n    ServerAliveInterval 30\n'
  done
  if [[ -n ${GTVPN_GT_USER:-} && ${GTVPN_GT_USER} =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'Match host *.gatech.edu,10.*,128.61.*,130.207.*,143.215.*\n    User %s\n' "$GTVPN_GT_USER"
  fi
} > /etc/ssh/ssh_config.d/60-gtvpn-hosts.conf
# Your hosts.conf (standard ssh config), if the host provided one.
/usr/local/sbin/gtvpn-hosts >/dev/null || log "WARNING: hosts.conf was not installed (see: gtvpn hosts)"
install -d -m 700 -o dev -g dev /home/dev/.ssh
install -d -o dev -g dev /home/dev/projects

# 4. sshd (key-only, user dev only) ------------------------------------------
if [[ ${GTVPN_SSHD:-1} == 1 ]]; then
  mkdir -p /var/lib/gtvpn/ssh /etc/gtvpn/authorized_keys
  [[ -s /var/lib/gtvpn/ssh/ssh_host_ed25519_key ]] || \
    ssh-keygen -q -t ed25519 -N '' -C gtvpn-host -f /var/lib/gtvpn/ssh/ssh_host_ed25519_key
  # Host key is published so the host can pin it (no TOFU prompts).
  /usr/local/sbin/gtvpn-outwrite ssh_host_ed25519_key.pub < /var/lib/gtvpn/ssh/ssh_host_ed25519_key.pub || true
  install -m 0644 -o root -g root /dev/null /etc/gtvpn/authorized_keys/dev
  [[ -r $IN/authorized_keys ]] && grep -E '^(ssh-|ecdsa-|sk-)' "$IN/authorized_keys" > /etc/gtvpn/authorized_keys/dev || true
  if [[ ! -s /etc/gtvpn/authorized_keys/dev ]]; then
    log "WARNING: no authorized_keys provided; SSH/VS Code Remote-SSH login disabled (use 'gtvpn shell')."
  fi
  sed -i "s|^SetEnv .*|SetEnv ${SESSION_ENV[*]}|" /etc/gtvpn/sshd_config
  /usr/sbin/sshd -t -f /etc/gtvpn/sshd_config
  /usr/sbin/sshd -D -e -f /etc/gtvpn/sshd_config 2>>/var/log/gtvpn/sshd.log &
fi

# 5. Allow-listed direct egress (Claude Code etc.), off the GT tunnel -------
if [[ ${GTVPN_DIRECT_EGRESS:-1} == 1 ]]; then
  /usr/local/sbin/gtvpn-egress start
fi

# 6. Pre-connect self-test: with no tunnel, nothing may get out --------------
if ! /usr/local/bin/gtvpn-verify --pre --quiet; then
  log "pre-connect leak self-test FAILED; refusing to run. Details:"
  /usr/local/bin/gtvpn-verify --pre || true
  exit 1
fi
log "pre-connect leak self-test passed"

# 7. Watchdog: re-verifies the kill-switch; if it was tampered with, the VPN
#    is torn down and the firewall re-applied.
(
  while sleep "${GTVPN_WATCHDOG_INTERVAL:-15}"; do
    if ! /usr/local/sbin/gtvpn-firewall check >/dev/null 2>&1; then
      log "watchdog: firewall drift detected, disconnecting and re-locking"
      /usr/local/sbin/gtvpn-disconnect >/dev/null 2>&1 || true
      /usr/local/sbin/gtvpn-firewall apply || true
    fi
  done
) &

term() {
  log "stopping"
  /usr/local/sbin/gtvpn-disconnect >/dev/null 2>&1 || true
  jobs -p | xargs -r kill 2>/dev/null || true
  exit 0
}
trap term TERM INT

log "ready. Connect with: gtvpn connect   (or: docker exec -it gtvpn gtvpn-connect)"
while true; do sleep 3600 & wait $!; done
