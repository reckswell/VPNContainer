#!/usr/bin/env bash
# gtvpn-hosts: install your hosts.conf (runtime/in/hosts.conf, copied there
# by the host's `gtvpn hosts` / `gtvpn up`) as the container's ssh hosts.
#
# The file is standard OpenSSH config. It is checked with `ssh -G` first; a
# file with errors is refused and the previous one stays in place. Every
# plain alias in it also gets the GT defaults (X11 for Cadence, compression,
# one Duo prompt per 8 h), after your own settings, so yours win.
set -euo pipefail
SRC=/run/gtvpn/in/hosts.conf
DST=/etc/gtvpn/user-hosts.conf
DEF=/etc/gtvpn/user-hosts-defaults.conf
[[ $(id -u) == 0 ]] || { echo "gtvpn-hosts must run as root" >&2; exit 1; }
tmp=$(mktemp /etc/gtvpn/.hosts.XXXXXX); trap 'rm -f "$tmp"' EXIT
if [[ -f $SRC && ! -L $SRC ]]; then head -c 262144 "$SRC" | tr -d '\r' > "$tmp"; else : > "$tmp"; fi
chmod 0644 "$tmp"
# Checked as dev, not root: a "Match exec" line would run its command.
if ! err=$(setpriv --reuid=dev --regid=dev --init-groups -- ssh -G -F "$tmp" gtvpn-config-check 2>&1 >/dev/null); then
  echo "hosts.conf has errors, keeping the previous hosts:" >&2
  printf '%s\n' "$err" | sed "s|$tmp|hosts.conf|g" >&2
  exit 1
fi
mv -fT "$tmp" "$DST"; trap - EXIT
# Plain aliases (no wildcards or negations) from the Host lines.
mapfile -t aliases < <(awk 'tolower($1)=="host"{for(i=2;i<=NF;i++) print $i}' "$DST" \
  | grep -E '^[A-Za-z0-9._-]+$' | awk '!seen[$0]++')
{
  echo "# Generated by gtvpn-hosts from hosts.conf: GT defaults for your aliases."
  if (( ${#aliases[@]} )); then
    echo "Host ${aliases[*]}"
    printf '    %s\n' "ForwardX11 yes" "ForwardX11Trusted yes" "Compression yes" \
      "ControlMaster auto" "ControlPath ~/.ssh/cm-%C" "ControlPersist 8h" \
      "ServerAliveInterval 30" "ServerAliveCountMax 4"
  fi
} > "$DEF.tmp"
chmod 0644 "$DEF.tmp"; mv -fT "$DEF.tmp" "$DEF"
echo "installed ${#aliases[@]} host(s)${aliases[*]:+: ${aliases[*]}}"
