#!/usr/bin/env bash
# One-screen status of the tunnel and the kill-switch.
TUN=${GTVPN_TUN_IF:-tun0}
b() { printf '\033[1m%s\033[0m\n' "$*"; }
b "Tunnel"
if ip -4 addr show "$TUN" 2>/dev/null | grep -q inet; then
  echo "  up: $(ip -4 -o addr show "$TUN" | awk '{print $4}')  portal: ${GTVPN_PORTAL:-vpn.gatech.edu}"
  pgrep -a -x 'gpclient|openconnect' | sed -E 's/^/  /; s/(--cookie[^ ]*) [^ ]+/\1 <redacted>/' | head -3
else
  echo "  down (container has no outside connectivity)"
fi
b "Routes"; ip -4 route | sed 's/^/  /'
b "DNS";    grep -E '^(nameserver|search)' /etc/resolv.conf | sed 's/^/  /'
b "Kill-switch"; /usr/local/sbin/gtvpn-firewall check | sed 's/^/  /'
echo "  blocked leak attempts since start: $(iptables -w 5 -nvxL GTVPN_BLOCKED 2>/dev/null | awk 'NR>2{s+=$1}END{print s+0}')"
b "Last verification"; sed 's/^/  /' /run/gtvpn/out/verify.txt 2>/dev/null | head -40 || echo "  none"
