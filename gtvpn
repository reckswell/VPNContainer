#!/usr/bin/env bash
# gtvpn: host-side control for the isolated Georgia Tech VPN container.
# Works on Ubuntu 24.04 and inside WSL2 (Windows). Run `./gtvpn help`.
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
cd "$HERE"
NAME=gtvpn
SSH_DIR="$HOME/.ssh/gtvpn"

c_b=$'\033[1m'; c_g=$'\033[32m'; c_r=$'\033[31m'; c_y=$'\033[33m'; c_0=$'\033[0m'
say()  { printf '%s[gtvpn]%s %s\n' "$c_b" "$c_0" "$*"; }
warn() { printf '%s[gtvpn] %s%s\n' "$c_y" "$*" "$c_0" >&2; }
die()  { printf '%s[gtvpn] %s%s\n' "$c_r" "$*" "$c_0" >&2; exit 1; }

is_wsl() { grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; }

# Container engine: docker (default) or podman (GTVPN_ENGINE=podman).
ENGINE=${GTVPN_ENGINE:-docker}
compose() {
  if [[ $ENGINE == podman ]]; then podman compose "$@"; else docker compose "$@"; fi
}
engine() { "$ENGINE" "$@"; }
running() { [[ $(engine inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null) == true ]]; }
need_running() { running || die "container is not running; start it with: ./gtvpn up"; }

# Read KEY=VALUE from .env without executing it.
envget() {
  local k=$1 line v=""
  [[ -f .env ]] || { echo ""; return; }
  line=$(grep -E "^${k}=" .env | tail -1 || true)
  v=${line#*=}; v=${v%\"}; v=${v#\"}; v=${v%\'}; v=${v#\'}
  printf '%s' "$v"
}
# gtvpn-login.conf: your GT sign-in for this computer only (.gitignore keeps
# it out of git; gtvpn-login.example.conf is its empty template). Keys
# username, password and, on Windows, password_dpapi (the launcher's
# encrypted form). Plain key=value lines, # comments, never executed; a
# value is taken as written, minus spaces at its ends.
LOCAL_CONF=$HERE/gtvpn-login.conf
REFUSED=$HERE/gtvpn-login.conf.refused
confget() {
  local want=${1,,} line k v=''
  [[ -f $LOCAL_CONF ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*([#\;]|$) || $line != *=* ]] && continue
    k=${line%%=*}; k=${k//[[:space:]]/}
    [[ ${k,,} == "$want" ]] || continue
    v=${line#*=}
    v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
  done <"$LOCAL_CONF"
  printf '%s' "$v"
}
# The saved password in plain text: password_dpapi decrypted by Windows for
# the account that saved it (WSL only), else password.
saved_password() {
  local d p ps
  d=$(confget password_dpapi)
  if [[ -n $d ]] && is_wsl; then
    ps=$(command -v powershell.exe || echo /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe)
    # shellcheck disable=SC2016  # PowerShell code
    p=$(printf '%s\n' "$d" | "$ps" -NoProfile -NonInteractive -Command '
      [Console]::OutputEncoding = New-Object Text.UTF8Encoding $false
      $s = ConvertTo-SecureString ([Console]::In.ReadLine())
      $b = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($s)
      try { [Console]::Out.Write([Runtime.InteropServices.Marshal]::PtrToStringBSTR($b)) }
      finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($b) }' 2>/dev/null | tr -d '\r') || p=''
    if [[ -n $p ]]; then printf '%s' "$p"; return 0; fi
    warn "Windows could not decrypt password_dpapi in gtvpn-login.conf (saved by another Windows account or PC?)"
  elif [[ -n $d ]]; then
    warn "password_dpapi in gtvpn-login.conf can only be read on the Windows PC that saved it"
  fi
  confget password
}
has_saved_signin() { [[ -f $LOCAL_CONF && -n $(confget password)$(confget password_dpapi) ]]; }
tunnel_up() { engine exec "$NAME" ip link show tun0 >/dev/null 2>&1; }
# Whether the running container takes a stashed sign-in (an older one would
# treat it as typed input and start a real sign-in with it).
can_stash() {
  # shellcheck disable=SC2016  # runs in the container
  engine exec -u root "$NAME" sh -c 'grep -q "^STASH=" /usr/local/sbin/gtvpn-connect && [ "$(stat -f -c %T /run/gtvpn/secret 2>/dev/null)" = tmpfs ]' >/dev/null 2>&1
}
# Hand the saved sign-in to the container for the next gtvpn-connect (see
# gtvpn-connect --stash). Prints why it did not, if it did not.
stash_signin() {
  local u p
  has_saved_signin || return 0
  tunnel_up && return 0   # already connected: gtvpn-connect just says so
  if ! can_stash; then
    warn "this container is older than the saved sign-in, so it is not used; type your password this time (it is updated at the next connect without a tunnel, or: gtvpn down && gtvpn up)"
    return 0
  fi
  if [[ -f $REFUSED && ! $LOCAL_CONF -nt $REFUSED ]]; then
    warn "GT refused your saved password on $(date -r "$REFUSED" '+%b %d %H:%M'). Not using it until you change gtvpn-login.conf; type your password this time."
    return 0
  fi
  u=$(confget username); [[ -n $u ]] || u=$(envget GTVPN_USER)
  if [[ ! $u =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
    warn "gtvpn-login.conf has a password but no valid username; type your sign-in this time"; return 0
  fi
  if ! is_wsl && [[ -n $(confget password) && -n $(find "$LOCAL_CONF" -perm /077 2>/dev/null) ]]; then
    chmod 600 "$LOCAL_CONF" && say "made gtvpn-login.conf readable only by you (it holds your password)"
  fi
  p=$(saved_password)
  [[ -n $p ]] || return 0
  printf '%s\n%s\n' "$u" "$p" | engine exec -i -u root "$NAME" gtvpn-connect --stash || true
}

envset() { # key value  (in-place, keeps the rest of the file)
  local k=$1 v=$2 tmp; tmp=$(mktemp)
  if grep -qE "^${k}=" .env; then
    awk -v k="$k" -v v="$v" 'BEGIN{FS=OFS="="} $1==k{$0=k"="v} {print}' .env > "$tmp"
  else cp .env "$tmp"; printf '%s=%s\n' "$k" "$v" >> "$tmp"; fi
  cat "$tmp" > .env; rm -f "$tmp"
}

open_url() { # url-or-file
  local u=$1 b; b=$(envget GTVPN_BROWSER)
  if [[ -n $b ]]; then
    # shellcheck disable=SC2086
    nohup $b "$u" >/dev/null 2>&1 & return
  fi
  if is_wsl; then
    if [[ -e $u ]]; then u=$(wslpath -w "$u"); fi
    if command -v wslview >/dev/null; then wslview "$u" >/dev/null 2>&1 & return; fi
    powershell.exe -NoProfile -Command "Start-Process '${u//\'/\'\'}'" >/dev/null 2>&1 & return
  fi
  command -v xdg-open >/dev/null && { xdg-open "$u" >/dev/null 2>&1 & return; }
  warn "could not open a browser; open this yourself: $u"
}

# ---------------------------------------------------------------------------
# X11: decide which X server socket the container gets, and an auth cookie.
x11_detect() {
  local disp sockdir
  if is_wsl; then
    # WSLg's X server. Docker Desktop (WSL integration) and Docker Engine
    # inside WSL both bind this distro path straight to the WSLg socket.
    disp=:0
    sockdir=/mnt/wslg/.X11-unix
  else
    disp=${DISPLAY:-:0}
    case $disp in
      :*|unix:*) ;;
      *) warn "DISPLAY=$disp is not a local X server; using :0"; disp=:0 ;;
    esac
    disp=":${disp##*:}"; disp=${disp%%.*}
    sockdir=/tmp/.X11-unix
  fi
  envset GTVPN_DISPLAY "$disp"
  envset GTVPN_X11_DIR "$sockdir"
}

x11_cookie() {
  # Fresh cookie each `up`: Xwayland generates a new one every login.
  mkdir -p runtime/in
  local out=runtime/in/xauth disp; disp=$(envget GTVPN_DISPLAY)
  rm -f "$out"
  if is_wsl; then return 0; fi          # WSLg needs no cookie
  if command -v xauth >/dev/null && [[ -n ${DISPLAY:-} ]]; then
    # 'ffff' = FamilyWild, so the cookie matches inside the container.
    if xauth nlist "$DISPLAY" 2>/dev/null | sed -e 's/^..../ffff/' | xauth -f "$out" nmerge - 2>/dev/null && [[ -s $out ]]; then
      chmod 600 "$out"; return 0
    fi
  fi
  rm -f "$out"
  # Fallback: allow just this local user (the container's 'dev' has your UID).
  if command -v xhost >/dev/null && [[ -n ${DISPLAY:-} ]]; then
    xhost "+SI:localuser:$(id -un)" >/dev/null 2>&1 || true
  fi
  [[ -n ${DISPLAY:-} ]] || warn "no DISPLAY in this shell; X11 apps will need 'gtvpn up' from a desktop session"
  : "${disp}"
}

# ---------------------------------------------------------------------------
ssh_setup() {
  mkdir -p "$SSH_DIR"; chmod 700 "$HOME/.ssh" "$SSH_DIR"
  [[ -s $SSH_DIR/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N '' -C "gtvpn-$(hostname)" -f "$SSH_DIR/id_ed25519"
  mkdir -p runtime/in
  # Keep any extra keys (e.g. the Windows-side key added by Setup-GtVpn.ps1).
  touch runtime/in/authorized_keys
  grep -qF "$(cut -d' ' -f2 "$SSH_DIR/id_ed25519.pub")" runtime/in/authorized_keys || cat "$SSH_DIR/id_ed25519.pub" >> runtime/in/authorized_keys
  chmod 644 runtime/in/authorized_keys
  write_ssh_config
  if ! grep -qF "Include $SSH_DIR/config" "$HOME/.ssh/config" 2>/dev/null; then
    local tmp; tmp=$(mktemp)
    { echo "Include $SSH_DIR/config"; echo; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$tmp"
    cat "$tmp" > "$HOME/.ssh/config"; rm -f "$tmp"; chmod 600 "$HOME/.ssh/config"
    say "added 'Include $SSH_DIR/config' to ~/.ssh/config"
  fi
}

write_ssh_config() {
  ssh_config_text "$SSH_DIR/id_ed25519" "$SSH_DIR/known_hosts" "$SSH_DIR/cm-%C" > "$SSH_DIR/config"; chmod 600 "$SSH_DIR/config"
  write_win_ssh_config
}
# Under WSL: a Windows environment variable (e.g. USERPROFILE), as C:\...
win_env() {
  local v; v=$(cd /mnt/c 2>/dev/null && cmd.exe /c "echo %$1%" 2>/dev/null | tr -d '\r') || return 1
  [[ $v =~ ^[A-Za-z]:\\ ]] || return 1
  printf '%s' "$v"
}
# On WSL, also refresh the copy Windows' ssh (and VS Code on Windows) reads,
# if Setup-GtVpn.ps1 created it. Windows OpenSSH has no ControlMaster.
write_win_ssh_config() {
  is_wsl || return 0
  local prof dir win
  prof=$(win_env USERPROFILE) || return 0
  dir=$(wslpath -u "$prof" 2>/dev/null)/.ssh/gtvpn
  [[ -f $dir/config ]] || return 0
  win=${prof//\\//}/.ssh/gtvpn
  ssh_config_text "$win/id_ed25519" "$win/known_hosts" none > "$dir/config"
}

# ---- hosts.conf: your GT servers, in standard OpenSSH config syntax --------
GT_MATCH='*.gatech.edu,10.*,128.61.*,130.207.*,143.215.*'
# GT names and GT's public address blocks, which this computer reaches only
# through the container (see ssh_config_text).
GT_VIA='*.gatech.edu,128.61.*,130.207.*,143.215.*'
hosts_ensure() {
  [[ -f hosts.conf ]] && return 0
  cp hosts.conf.example hosts.conf && say "created hosts.conf (list your GT servers there)"
}
# The plain aliases (no wildcards or negations) on its Host lines.
hosts_aliases() {
  [[ -f hosts.conf ]] || return 0
  tr -d '\r' < hosts.conf | awk 'tolower($1)=="host"{for(i=2;i<=NF;i++) print $i}' \
    | grep -E '^[A-Za-z0-9._-]+$' | awk '!seen[$0]++' || true
}
# "hostname user port" for an alias, as ssh inside the container sees it
# (user/port are empty when not set and default).
hosts_resolve() { # alias
  local f u; f=$(mktemp); tr -d '\r' < hosts.conf > "$f"
  u=$(envget GTVPN_GT_USER)
  [[ $u =~ ^[A-Za-z0-9._-]+$ ]] && printf '\nMatch host %s\n    User %s\n' "$GT_MATCH" "$u" >> "$f"
  printf '\nHost *\n    User gtvpn-unset\n' >> "$f"
  ssh -G -F "$f" "$1" 2>/dev/null | awk '$1=="hostname"{h=$2} $1=="user"{u=$2} $1=="port"{p=$2}
    END{ if (u=="gtvpn-unset") u="-"; if (p=="22") p="-"; if (h!="") print h, u, p }'
  rm -f "$f"
}
# Check hosts.conf and hand a copy to the container (runtime/in).
hosts_sync() {
  hosts_ensure || return 1
  command -v ssh >/dev/null || { warn "no ssh client here; hosts.conf entries won't show in VS Code (sudo apt install openssh-client)"; }
  local f err; f=$(mktemp); tr -d '\r' < hosts.conf > "$f"
  if command -v ssh >/dev/null && ! err=$(ssh -G -F "$f" gtvpn-config-check 2>&1 >/dev/null); then
    rm -f "$f"; warn "hosts.conf has errors: ${err//$f/hosts.conf}"; return 1
  fi
  local u; u=$(envget GTVPN_GT_USER)
  mkdir -p runtime/in
  {
    cat "$f"
    # Default GT username for the container, after your settings (yours win).
    [[ $u =~ ^[A-Za-z0-9._-]+$ ]] && printf '\n# Added by gtvpn from GTVPN_GT_USER in .env\nMatch host %s\n    User %s\n' "$GT_MATCH" "$u"
  } > runtime/in/hosts.conf
  rm -f "$f"
  chmod 644 runtime/in/hosts.conf 2>/dev/null || true
}
cmd_hosts() {
  hosts_sync || die "fix hosts.conf and run ./gtvpn hosts again (nothing was changed)"
  write_ssh_config
  if running; then engine exec -u root "$NAME" gtvpn-hosts >/dev/null || die "the container refused hosts.conf (see above)"; fi
  local a h u p n=0
  while read -r a; do
    read -r h u p < <(hosts_resolve "$a") || continue
    [[ $u == - ]] && u=""; [[ $p == - ]] && p=""
    printf '  %-12s -> %s%s%s   (container: ssh %s   VS Code: gt-%s)\n' "$a" "${u:+$u@}" "$h" "${p:+:$p}" "$a" "$a"
    n=$((n+1))
  done < <(hosts_aliases)
  if (( n )); then say "$n host(s) from hosts.conf are ready"; else say "hosts.conf has no hosts yet; add yours and run ./gtvpn hosts again"; fi
}

ssh_config_text() { # identity known_hosts controlpath|none
  local id=$1 kh=$2 cm=$3 port user hosts pair alias fq
  port=$(envget GTVPN_SSH_PORT); port=${port:-2222}
  user=$(envget GTVPN_GT_USER); hosts=$(envget GTVPN_SSH_HOSTS)
  {
    echo "# Managed by gtvpn ($HERE). Do not edit: list your hosts in hosts.conf, then run: gtvpn hosts"
    echo "Host gtvpn"
    echo "    HostName 127.0.0.1"
    echo "    Port $port"
    echo "    User dev"
    echo "    IdentityFile $id"
    echo "    IdentitiesOnly yes"
    echo "    UserKnownHostsFile $kh"
    echo "    StrictHostKeyChecking yes"
    echo "    ForwardAgent no"
    echo "    ForwardX11 no"
    echo "    ServerAliveInterval 30"
    local seen=" " h u p
    if command -v ssh >/dev/null; then
      while read -r alias; do
        read -r h u p < <(hosts_resolve "$alias") || continue
        [[ $h =~ ^[A-Za-z0-9._-]+$ && $u =~ ^([A-Za-z0-9._-]+|-)$ && $p =~ ^([0-9]+|-)$ ]] || continue
        seen+="$alias "
        echo
        echo "# '$alias' from hosts.conf, reached THROUGH the container's tunnel"
        echo "Host gt-$alias"
        echo "    HostName $h"
        [[ $u != - ]] && echo "    User $u"
        [[ $p != - ]] && echo "    Port $p"
        echo "    ProxyJump gtvpn"
        if [[ $cm != none ]]; then
          echo "    ControlMaster auto"
          echo "    ControlPath $cm"
          echo "    ControlPersist 8h"
        fi
        echo "    ServerAliveInterval 30"
      done < <(hosts_aliases)
    fi
    for pair in $hosts; do
      alias=${pair%%=*}; fq=${pair#*=}
      [[ -n $alias && -n $fq && $alias != "$pair" ]] || continue
      [[ $seen == *" $alias "* ]] && continue
      echo
      echo "# GT host '$alias' reached THROUGH the container's tunnel"
      echo "Host gt-$alias"
      echo "    HostName $fq"
      [[ -n $user ]] && echo "    User $user"
      echo "    ProxyJump gtvpn"
      if [[ $cm != none ]]; then
        echo "    ControlMaster auto"
        echo "    ControlPath $cm"
        echo "    ControlPersist 8h"
      fi
      echo "    ServerAliveInterval 30"
    done
    # Every other GT server, typed by name or GT address (VS Code Remote-SSH
    # "Connect to Host", or ssh here), also goes through the container, so
    # this computer never connects to GT itself. 10.* is left out: it is
    # also used by home and other private networks.
    if [[ $(envget GTVPN_SSH_VIA_CONTAINER) != 0 ]]; then
      echo
      echo "# Any other GT server (by name or GT address): also THROUGH the container's tunnel"
      echo "Match host $GT_VIA"
      echo "    ProxyJump gtvpn"
      [[ $user =~ ^[A-Za-z0-9._-]+$ ]] && echo "    User $user"
      if [[ $cm != none ]]; then
        echo "    ControlMaster auto"
        echo "    ControlPath $cm"
        echo "    ControlPersist 8h"
      fi
      echo "    ServerAliveInterval 30"
    fi
  }
}

pin_hostkey() {
  local port pub; port=$(envget GTVPN_SSH_PORT); port=${port:-2222}
  for _ in $(seq 30); do [[ -s runtime/out/ssh_host_ed25519_key.pub ]] && break; sleep 1; done
  pub=$(cut -d' ' -f1,2 runtime/out/ssh_host_ed25519_key.pub 2>/dev/null || true)
  [[ -n $pub ]] || { warn "container host key not published yet"; return; }
  echo "[127.0.0.1]:$port $pub" > "$SSH_DIR/known_hosts"; chmod 600 "$SSH_DIR/known_hosts"
}

install_url_handler() {
  # Lets the browser hand the GT sign-in result straight back to the container.
  if is_wsl; then
    say "Windows: the link handler is installed by windows\\Setup-GtVpn.ps1"
    return
  fi
  command -v xdg-mime >/dev/null || { warn "xdg-mime not found; you will paste the sign-in link manually"; return; }
  local d="$HOME/.local/share/applications"; mkdir -p "$d"
  cat > "$d/gtvpn-callback.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=GT VPN sign-in (gtvpn)
Comment=Hands the GlobalProtect SSO result to the isolated gtvpn container
Exec=$HERE/gtvpn callback %u
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/globalprotectcallback;
EOF
  xdg-mime default gtvpn-callback.desktop x-scheme-handler/globalprotectcallback
  command -v update-desktop-database >/dev/null && update-desktop-database "$d" >/dev/null 2>&1 || true
  say "registered the globalprotectcallback: link handler"
}

# VS Code Dev Containers: "Attach to Running Container" opens the container
# through Docker (docker exec), with no network hop. This per-image config
# makes it log in as dev (never root, which holds the kill-switch) and open
# ~/projects. VS Code reads it from its globalStorage; on WSL that is the
# Windows VS Code's, under %APPDATA%.
vscode_attach_config() {
  local base app d n=0
  if is_wsl; then
    app=$(win_env APPDATA) || { warn "could not find %APPDATA%; VS Code attach config not installed"; return 0; }
    base=$(wslpath -u "$app")
  else
    base=${XDG_CONFIG_HOME:-$HOME/.config}
  fi
  for d in "$base/Code" "$base/Code - Insiders"; do
    [[ -d $d/User ]] || continue
    d="$d/User/globalStorage/ms-vscode-remote.remote-containers/imageConfigs"
    mkdir -p "$d" && cp vscode/attached-container-config.json "$d/gtvpn%3alocal.json" && n=$((n+1))
  done
  ((n)) || warn "VS Code not found; open it once, then run: gtvpn setup (for Dev Containers attach)"
}

# vscode-remote URI that attaches to the gtvpn container and opens PATH.
vscode_attach_uri() { # path
  local p=${1:-/home/dev/projects} hex
  [[ $p =~ ^/[A-Za-z0-9._/~@+-]*$ ]] || die "use an absolute container path without spaces, e.g. /home/dev/projects"
  hex=$(printf '{"containerName":"/%s"}' "$NAME" | od -An -v -tx1 | tr -d ' \n')
  printf 'vscode-remote://attached-container+%s%s' "$hex" "$p"
}

cmd_code() {
  local ssh=0 uri
  [[ ${1:-} == --ssh ]] && { ssh=1; shift; }
  need_running
  if ((ssh)); then pin_hostkey; set -- --remote ssh-remote+gtvpn "${1:-/home/dev/projects}"
  else
    uri=$(vscode_attach_uri "${1:-}") || exit 1
    vscode_attach_config >/dev/null 2>&1 || true
    set -- --folder-uri "$uri"
  fi
  if is_wsl; then
    # Windows' VS Code (code.cmd on the Windows PATH), so it uses Docker Desktop.
    (cd /mnt/c && cmd.exe /c code "$@") || die "VS Code 'code' command not found on the Windows PATH"
  else
    command -v code >/dev/null || die "VS Code 'code' command not found on PATH"
    code "$@"
  fi
}

cmd_setup() {
  command -v "$ENGINE" >/dev/null || die "$ENGINE is not installed (see README: Install)"
  [[ -e /dev/net/tun ]] || warn "/dev/net/tun missing on this machine (sudo modprobe tun)"
  [[ -f .env ]] || { cp .env.example .env; say "created .env (edit it to add your GT hosts)"; }
  envset HOST_UID "$(id -u)"; envset HOST_GID "$(id -g)"
  [[ $(id -u) != 0 ]] || die "run gtvpn as your normal user, not root"
  x11_detect
  hosts_sync || true
  ssh_setup
  install_url_handler
  vscode_attach_config
  mkdir -p runtime/out share
  say "setup done. Next: ./gtvpn up && ./gtvpn connect"
}

cmd_up() {
  [[ -f .env ]] || cmd_setup
  hosts_sync || warn "starting without your hosts.conf changes; fix it, then run: ./gtvpn hosts"
  x11_detect; x11_cookie; write_ssh_config
  local b=--build; [[ " $* " == *" --no-build "* ]] && b=""
  compose up -d $b "$@"
  for _ in $(seq 90); do
    engine logs "$NAME" 2>&1 | grep -q 'ready\.' && break
    if ! running; then engine logs --tail 40 "$NAME" >&2; die "container exited (see log above)"; fi
    sleep 1
  done
  engine logs "$NAME" 2>&1 | grep -q 'ready\.' || { engine logs --tail 40 "$NAME" >&2; die "container did not become ready"; }
  pin_hostkey
  # A bind of a missing folder gives the container an empty one, silently.
  local d; d=$(envget GTVPN_DISPLAY); d=${d#:}
  engine exec -u dev "$NAME" test -S "/tmp/.X11-unix/X${d:-0}" 2>/dev/null \
    || warn "the container cannot see the X11 socket $(envget GTVPN_X11_DIR)/X${d:-0}; GUI apps (Cadence) will not open. See README: Troubleshooting."
  say "container is up and sealed (no tunnel yet). Next: ./gtvpn connect"
}

# Open the sign-in page the container published. runtime/out is writable
# from inside the container, so its content is untrusted: open only an
# https:// address or our own regular login.html, never a program, a path
# or another URL scheme (Start-Process / xdg-open would run those).
open_signin() {
  local u f=$HERE/runtime/out/login.html
  u=$(head -1 runtime/out/login.url 2>/dev/null || true)
  if [[ $u == file:login.html && -f $f && ! -L $f ]]; then open_url "$f"
  elif [[ ${#u} -le 8192 && $u =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^[:space:]\"\'\`\\\<\>]*)?$ ]]; then open_url "$u"
  else warn "ignored an unexpected sign-in address from the container: ${u:0:120}"; return 1; fi
}

cmd_connect() {
  running || cmd_up
  # A container from before the saved sign-in: recreate it on this version,
  # but only while no tunnel is up (that would drop it).
  if has_saved_signin && ! tunnel_up && ! can_stash; then
    say "updating the container to this version for the saved sign-in (no tunnel is up)"
    cmd_up
  fi
  rm -f runtime/out/login.url
  # Open the GT sign-in page in the host browser when the container asks.
  (
    for _ in $(seq 120); do
      if [[ -s runtime/out/login.url ]]; then open_signin; exit 0; fi
      sleep 0.5
    done
  ) &
  local opener=$! rc=0
  stash_signin
  engine exec -it -u root "$NAME" gtvpn-connect || rc=$?
  kill $opener 2>/dev/null || true
  if (( rc == 3 )); then
    touch "$REFUSED"
    die "connect failed: GT refused the saved password. Fix it in gtvpn-login.conf; until then you will be asked to type it."
  fi
  (( rc == 0 )) || die "connect failed"
  rm -f "$REFUSED"
  echo
  cmd_host_verify || true
}

cmd_callback() {
  local data=${1:-}
  [[ -n $data ]] || IFS= read -r data
  printf '%s\n' "$data" | engine exec -i -u root "$NAME" gtvpn-callback
  command -v notify-send >/dev/null && notify-send "GT VPN" "Sign-in handed to the gtvpn container" 2>/dev/null || true
}

cmd_verify() {
  need_running
  local rc=0
  engine exec -u root "$NAME" gtvpn-verify "$@" || rc=1
  echo
  cmd_host_verify || rc=1
  return $rc
}

cmd_host_verify() { bash "$HERE/host/verify-host.sh"; }

cmd_watch() {
  need_running
  local n=${1:-60} i=0
  say "re-verifying every ${n}s (Ctrl-C to stop)"
  while true; do
    i=$((i+1))
    if engine exec -u root "$NAME" gtvpn-verify --quiet >/dev/null && bash "$HERE/host/verify-host.sh" --quiet >/dev/null; then
      printf '%s round %d: %ssealed%s\n' "$(date +%T)" "$i" "$c_g" "$c_0"
    else
      printf '%s round %d: %sPROBLEM%s (run ./gtvpn verify)\n' "$(date +%T)" "$i" "$c_r" "$c_0"
      command -v notify-send >/dev/null && notify-send -u critical "GT VPN" "gtvpn verification failed" 2>/dev/null || true
    fi
    sleep "$n"
  done
}

# ---- vnc: smooth Cadence windows -------------------------------------------
# The session is the GT server's own TigerVNC X server (gtvpn-vnc in the
# container starts it; nothing is installed there). The container's shared
# connection forwards its 127.0.0.1:P to the session's private socket; here
# a hidden `ssh gtvpn` forwards this computer's 127.0.0.1:P to that port, and
# the TigerVNC viewer connects to it. This computer never talks to GT.
# TigerVNC's viewer for Windows is one signed file; this exact one is pinned.
VNC_WIN_VERSION=1.15.0
VNC_WIN_URL=https://downloads.sourceforge.net/project/tigervnc/stable/$VNC_WIN_VERSION/vncviewer64-$VNC_WIN_VERSION.exe
VNC_WIN_SHA256=fe55c1a0ff15c6ee8aa3f77ac98318504b6ab50257182f7df6a12f9b2d90e1f3
vnc_viewer_cmd() { # the viewer program, or nothing
  local v d f l; v=$(envget GTVPN_VNC_VIEWER)
  if [[ -n $v ]]; then [[ -f $v ]] && { printf '%s\n' "$v"; return 0; }; return 1; fi
  if is_wsl; then
    l=$(win_env LOCALAPPDATA) && l=$(wslpath -u "$l" 2>/dev/null) || l=
    for d in ${l:+"$l/Programs/TigerVNC"} "/mnt/c/Program Files/TigerVNC" "/mnt/c/Program Files (x86)/TigerVNC"; do
      for f in "$d"/vncviewer64-*.exe "$d"/vncviewer.exe "$d"/vncviewer64.exe; do
        [[ -f $f ]] && { printf '%s\n' "$f"; return 0; }
      done
    done
    return 1
  fi
  command -v vncviewer || command -v xtigervncviewer
}
# On Windows, offer to download the viewer into %LOCALAPPDATA%\Programs\TigerVNC
# (no admin rights; 24 MB), checked against the pinned SHA-256.
vnc_install_viewer() {
  is_wsl && [[ -t 0 ]] || return 1
  local la dest r; la=$(win_env LOCALAPPDATA) || return 1
  dest=$(wslpath -u "$la")/Programs/TigerVNC
  printf 'The TigerVNC viewer for Windows is not installed. Download it (%s, 24 MB, no admin rights needed) into %s\\Programs\\TigerVNC? [Y/n] ' "$VNC_WIN_VERSION" "$la"
  read -r r; [[ -z $r || $r == [Yy]* ]] || return 1
  mkdir -p "$dest" || return 1
  curl -fL --retry 5 --retry-all-errors --progress-bar -o "$dest/.download" "$VNC_WIN_URL" \
    || { rm -f "$dest/.download"; warn "the download failed: $VNC_WIN_URL"; return 1; }
  [[ $(sha256sum "$dest/.download" | cut -d' ' -f1) == "$VNC_WIN_SHA256" ]] \
    || { rm -f "$dest/.download"; warn "the downloaded viewer does not match its pinned checksum; not installed"; return 1; }
  mv "$dest/.download" "$dest/vncviewer64-$VNC_WIN_VERSION.exe" || return 1
  say "TigerVNC viewer installed in $la\\Programs\\TigerVNC"
}
# This computer's 127.0.0.1:P -> the container's 127.0.0.1:P, through the
# container's sshd (key-only, loopback), in the background.
vnc_local_forward() { # port
  local p=$1
  if is_wsl; then
    local probe="\$c=New-Object Net.Sockets.TcpClient; try { if (\$c.ConnectAsync('127.0.0.1',$p).Wait(700)) { exit 0 } } catch {}; exit 1"
    powershell.exe -NoProfile -Command "$probe" >/dev/null 2>&1 && return 0
    powershell.exe -NoProfile -Command "Start-Process -WindowStyle Hidden -FilePath ssh -ArgumentList '-N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L 127.0.0.1:${p}:127.0.0.1:$p gtvpn'" >/dev/null 2>&1 \
      || die "could not start the forward to the container (Windows ssh)"
    local _; for _ in 1 2 3 4 5 6 7 8; do sleep 0.5; powershell.exe -NoProfile -Command "$probe" >/dev/null 2>&1 && return 0; done
    die "the forward through ssh gtvpn did not open; check that 'ssh gtvpn' works in PowerShell (gtvpn setup configures it)"
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && return 0
    ssh -f -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o LogLevel=error \
      -L "127.0.0.1:$p:127.0.0.1:$p" gtvpn </dev/null >/dev/null 2>&1 \
      || die "could not start the forward to the container (ssh gtvpn; check that ssh gtvpn works)"
  fi
}
vnc_attach() { # port host
  local exe; exe=$(vnc_viewer_cmd) || { vnc_install_viewer && exe=$(vnc_viewer_cmd); } || {
    if is_wsl; then die "the TigerVNC viewer for Windows is not installed. Run gtvpn vnc $2 attach in a terminal to install it, or get vncviewer64-$VNC_WIN_VERSION.exe from https://sourceforge.net/projects/tigervnc/files/stable/$VNC_WIN_VERSION/ into %LOCALAPPDATA%\\Programs\\TigerVNC"
    else die "no VNC viewer here. Install one (Ubuntu: sudo apt install tigervnc-viewer), then run: gtvpn vnc $2 attach"; fi
  }
  vnc_local_forward "$1"
  # AutoSelect picks the compression from the measured line speed;
  # RemoteResize makes the GT desktop follow the viewer window's size.
  local extra; extra=$(envget GTVPN_VNC_VIEWER_ARGS)
  local -a a=(-SecurityTypes=None -AutoSelect=1 -RemoteResize=1 -AcceptClipboard=1 -SendClipboard=1)
  # shellcheck disable=SC2206
  a+=($extra "127.0.0.1::$1")
  if is_wsl; then
    local w j; w=$(wslpath -w "$exe"); j="${a[*]}"
    powershell.exe -NoProfile -Command "Start-Process -FilePath '${w//\'/\'\'}' -ArgumentList '${j//\'/\'\'}'" >/dev/null 2>&1 \
      || die "could not start the VNC viewer ($w)"
  else
    setsid -f "$exe" "${a[@]}" >/dev/null 2>&1 < /dev/null || die "could not start the VNC viewer"
  fi
  say "viewer opening: the GT desktop with your Cadence windows appears in a window here"
}
# gtvpn's own viewer (windows/viewer): every Cadence window as a window of its
# own here, with Windows' title bars, instead of one desktop in a viewer
# window. It is built from source on first use with the C# compiler that
# comes with Windows (.NET Framework 4); elsewhere mono runs it (for tests).
vnc_viewer_exe() { # print the built viewer's path
  local src="$HERE/windows/viewer" out f
  local -a cs=("$src"/*.cs)
  [[ -f ${cs[0]} ]] || die "the viewer's source is missing ($src)"
  if is_wsl; then
    local la win csc; la=$(win_env LOCALAPPDATA) || die "could not read %LOCALAPPDATA%"
    out=$(wslpath -u "$la")/gtvpn/gtvpn-viewer.exe
    win=$(win_env WINDIR) || win='C:\Windows'
    csc=$(wslpath -u "$win")/Microsoft.NET/Framework64/v4.0.30319/csc.exe
  else
    out=${XDG_CACHE_HOME:-$HOME/.cache}/gtvpn/gtvpn-viewer.exe
  fi
  if [[ ! -f $out || -n $(find "$src" -name '*.cs' -newer "$out" 2>/dev/null) ]]; then
    mkdir -p "${out%/*}" || die "could not create ${out%/*}"
    if is_wsl; then
      [[ -f $csc ]] || die "the C# compiler of .NET Framework 4 is missing ($csc); it is part of Windows 10 and 11"
      local -a w=(); for f in "${cs[@]}"; do w+=("$(wslpath -w "$f")"); done
      (cd "${out%/*}" && "$csc" /nologo /target:winexe /optimize+ /out:gtvpn-viewer.exe \
        /r:System.Windows.Forms.dll /r:System.Drawing.dll "${w[@]}") >&2 || die "could not build the viewer"
    else
      if ! command -v mcs >/dev/null || ! command -v mono >/dev/null; then
        die "gtvpn's viewer is for Windows (on Linux it needs mono); use: gtvpn vnc <host> attach"
      fi
      mcs -langversion:5 -optimize+ -target:winexe -out:"$out" -r:System.Windows.Forms.dll -r:System.Drawing.dll "${cs[@]}" >&2 \
        || die "could not build the viewer"
    fi
    say "built the viewer: $out" >&2
  fi
  printf '%s\n' "$out"
}
vnc_windows() { # host display: open the viewer on the session
  local host=$1 n=${2#:} exe c p q
  exe=$(vnc_viewer_exe) || exit 1
  p=$((15900 + n)); q=$((16300 + n))
  c=$({ engine exec -u dev "$NAME" gtvpn-vnc "$host" cookie 2>/dev/null || true; } | tr -d '\r' | sed -n 's/^cookie=//p')
  [[ $c =~ ^[0-9a-f]{32}$ ]] || die "could not read the session's cookie from $host"
  vnc_local_forward "$p"; vnc_local_forward "$q"
  local args="--vnc 127.0.0.1:$p --x11 127.0.0.1:$q --label $host:$n" extra
  extra=$(envget GTVPN_VIEWER_ARGS)
  [[ $extra =~ ^[-a-zA-Z0-9\ ._]*$ ]] || die "GTVPN_VIEWER_ARGS in .env may hold only options such as: --encoding tight"
  [[ -z $extra ]] || args+=" $extra"
  # The cookie goes in the environment, never on a command line.
  if is_wsl; then
    local w; w=$(wslpath -w "$exe")
    GTVPN_X_COOKIE=$c WSLENV=GTVPN_X_COOKIE powershell.exe -NoProfile -Command \
      "Start-Process -FilePath '${w//\'/\'\'}' -ArgumentList '$args'" >/dev/null 2>&1 \
      || die "could not start the viewer ($w)"
  else
    # shellcheck disable=SC2086
    GTVPN_X_COOKIE=$c setsid -f mono "$exe" $args >/dev/null 2>&1 < /dev/null || die "could not start the viewer"
  fi
  say "viewer opening: each window of the session appears here as a window of its own"
}
vnc_session() { # host field: the running session's port= or display= value, from the container
  { engine exec -u dev "$NAME" gtvpn-vnc "$1" display 2>/dev/null || true; } | tr -d '\r' | sed -n "s/^$2=//p"
}
cmd_vnc() {
  need_running
  local host=${1:-} action=${2:-start} p d
  local u="usage: gtvpn vnc <host> [start|windows|attach|status|stop [--force]]"
  [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || die "$u"
  case $action in
    start)
      # In the terminal (it may ask for the GT password and Duo once), then
      # ask for the port without one.
      engine exec -it -u dev -w /home/dev "$NAME" gtvpn-vnc "$host" start || die "could not start the session"
      p=$(vnc_session "$host" port); [[ $p =~ ^[0-9]+$ ]] || die "no session reported by $host"
      d=$(vnc_session "$host" display)
      vnc_attach "$p" "$host"
      cat <<EOF
Session display on $host: $d (it keeps running if the viewer, VS Code or the tunnel disconnect)
In a terminal on $host (for example VS Code's), before starting Cadence:
    export DISPLAY=$d        # bash
    setenv DISPLAY $d        # tcsh
Reopen the viewer: gtvpn vnc $host attach. End the session: gtvpn vnc $host stop
EOF
      ;;
    windows)
      engine exec -it -u dev -w /home/dev "$NAME" gtvpn-vnc "$host" windows || die "could not start the session"
      d=$(vnc_session "$host" display); [[ $d =~ ^:[0-9]+$ ]] || die "no session reported by $host"
      vnc_windows "$host" "$d"
      cat <<EOF
Session display on $host: $d (it keeps running if the viewer, VS Code or the tunnel disconnect)
In a terminal on $host (for example VS Code's), before starting Cadence:
    export DISPLAY=$d        # bash
    setenv DISPLAY $d        # tcsh
Reopen the windows: gtvpn vnc $host windows. End the session: gtvpn vnc $host stop
EOF
      ;;
    attach)
      p=$(vnc_session "$host" port)
      [[ $p =~ ^[0-9]+$ ]] || die "no session on $host (or no open connection to it); start one with: gtvpn vnc $host"
      # Title bars inside the desktop again if gtvpn's own viewer was the window manager.
      engine exec -u dev "$NAME" gtvpn-vnc "$host" wm >/dev/null 2>&1 || true
      vnc_attach "$p" "$host" ;;
    status) engine exec -it -u dev -w /home/dev "$NAME" gtvpn-vnc "$host" status ;;
    stop) engine exec -it -u dev -w /home/dev "$NAME" gtvpn-vnc "$host" stop "${3:-}" ;;
    *) die "$u" ;;
  esac
}

usage() {
  cat <<EOF
${c_b}gtvpn${c_0} - Georgia Tech GlobalProtect in an isolated container

  setup            one-time: .env, SSH key + config, X11, sign-in link handler
  up               build/start the container (sealed, no tunnel yet)
  connect          sign in (GT password, then Duo passcode) and start the tunnel
  disconnect       stop the tunnel (container stays sealed)
  status           tunnel, routes, DNS, kill-switch state
  verify           full leak/reachability checks, container AND host side
  watch [secs]     re-run all checks forever, alert on any failure
  shell            bash in the container as 'dev'
  hosts            apply hosts.conf (your GT servers) to the container and VS Code
  ssh <alias|host> ssh to a GT host from inside the container (X11 on)
  code [path]      open VS Code in the container (Dev Containers attach, as dev)
  code --ssh [path]  the same over Remote-SSH instead
  claude [args]    run Claude Code inside the container
  x11test          show a test window (xeyes) from the container
  display <host> [status|stop]
                   keep an X display open on a GT server for terminals that
                   ssh -Y did not open (VS Code Remote-SSH): Cadence there
                   then needs  export DISPLAY=\$(cat ~/.gtvpn-display)
  vnc <host> [start|windows|attach|status|stop]
                   smooth Cadence: a persistent VNC session on a GT server
                   (its own TigerVNC, nothing installed), in a viewer window
                   here; Cadence there then needs  export DISPLAY=:N  (printed).
                   windows: each Cadence window as a window of its own here
                   (gtvpn's viewer for Windows) instead of one desktop
  logs             container + VPN client logs
  callback <url>   (used by the browser link handler)
  rebuild          rebuild the image (updates Claude Code / base packages)
  down             stop and remove the container (home volume is kept)
EOF
}

# Sourcing (tests) defines the functions without running a command.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
cmd=${1:-help}; shift || true
case $cmd in
  setup) cmd_setup ;;
  up) cmd_up "$@" ;;
  connect) cmd_connect ;;
  disconnect) need_running; engine exec -u root "$NAME" gtvpn-disconnect ;;
  status) need_running; engine exec -u root "$NAME" gtvpn-status ;;
  verify) cmd_verify "$@" ;;
  host-verify) cmd_host_verify ;;
  watch) cmd_watch "$@" ;;
  shell) need_running; engine exec -it -u dev -w /home/dev "$NAME" bash -l ;;
  ssh) need_running; engine exec -it -u dev -w /home/dev "$NAME" bash -lc "ssh $(printf '%q ' "$@")" ;;
  claude) need_running; engine exec -it -u dev -w "${GTVPN_WORKDIR:-/home/dev}" "$NAME" bash -lc "claude $(printf '%q ' "$@")" ;;
  code) cmd_code "$@" ;;
  x11test) need_running # xeyes still open after 10 s (timeout's 124) means it worked
    engine exec -u dev "$NAME" bash -lc 'echo "DISPLAY=$DISPLAY"
      xdpyinfo >/dev/null 2>&1 || { echo "X11 test failed: the container cannot reach your X display"; exit 1; }
      echo "showing xeyes for 10 seconds"; timeout 10 xeyes; rc=$?
      if [ $rc -eq 0 ] || [ $rc -eq 124 ]; then echo "X11 works"; else echo "X11 test failed (xeyes exit $rc)"; exit 1; fi' ;;
  display) need_running; [[ ${1:-} ]] || die "usage: gtvpn display <host> [status|stop]"
    engine exec -it -u dev -w /home/dev "$NAME" bash -lc "gtvpn-display $(printf '%q ' "$@")" ;;
  vnc) cmd_vnc "$@" ;;
  logs) engine logs --tail 100 "$NAME"
    engine exec -u root "$NAME" sh -c 'for f in connect gpclient; do [ -s /var/log/gtvpn/$f.log ] || continue; echo "--- $f.log"; tail -n 50 /var/log/gtvpn/$f.log | sed "s/\x1b\[[0-9;]*[A-Za-z]//g; s/\r//g"; done' || true ;;
  callback) cmd_callback "$@" ;;
  hosts) cmd_hosts ;;
  ssh-config) ssh_config_text "${1:-$SSH_DIR/id_ed25519}" "${2:-$SSH_DIR/known_hosts}" "${3:-$SSH_DIR/cm-%C}" ;;
  hostkey) pin_hostkey >/dev/null 2>&1 || true; cut -d' ' -f1,2 runtime/out/ssh_host_ed25519_key.pub ;;
  authorize) # add a public key (stdin) that may log in to the container, e.g. from Windows
    IFS= read -r k; [[ $k =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-[a-z0-9-]+|sk-[a-z0-9@.-]+)\ [A-Za-z0-9+/=]+ ]] || die "not an ssh public key"
    mkdir -p runtime/in; touch runtime/in/authorized_keys
    grep -qF "$(cut -d' ' -f2 <<<"$k")" runtime/in/authorized_keys || echo "$k" >> runtime/in/authorized_keys
    say "key authorized (takes effect on next ./gtvpn up)" ;;
  rebuild) x11_detect; compose build --pull --no-cache; say "rebuilt; restart with ./gtvpn down && ./gtvpn up" ;;
  down) compose down ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
