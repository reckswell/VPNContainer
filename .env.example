# gtvpn settings. `./gtvpn setup` copies this to .env and fills in the
# machine-specific values (UIDs, X11 paths). Edit .env, then `./gtvpn up`.

# ---- VPN ---------------------------------------------------------------------
GTVPN_PORTAL=vpn.gatech.edu
# 1: sign in at a GT gateway directly (GTVPN_GATEWAY): your password and one
# Duo code. 0: go through the portal first. GT's gateways then run their own
# password + Duo sign-in anyway, so you type both twice.
GTVPN_SKIP_PORTAL=1
# The gateway: dc-ext-gw.vpn.gatech.edu or ni-ext-gw.vpn.gatech.edu.
GTVPN_GATEWAY=dc-ext-gw.vpn.gatech.edu
# With GTVPN_SKIP_PORTAL=0, the gateway by the name the portal gives it:
# "DC Gateway" or "NI Gateway" (empty: you are asked each time).
GTVPN_GATEWAY_NAME="DC Gateway"
# auto | saml | password   (auto asks the portal; GT uses password + Duo:
# your GT password, then the 6-digit Duo passcode shown in Duo Mobile)
GTVPN_AUTH=auto
# Your GT username, so you are not asked for it each time (optional)
GTVPN_USER=
# Which client signs in: auto (OpenConnect for password portals like GT's,
# gpclient for SSO portals), openconnect, or gpclient.
GTVPN_CLIENT=auto
# Some gateways ask for a Host Information Profile (HIP) report; GT's does.
# The client's built-in report describes a made-up Windows PC (antivirus
# included), so it is off by default; see docs/DESIGN.md.
GTVPN_HIP=0
# What the client reports itself as. Empty: what it is, a Linux client
# (OpenConnect's own identity). To look like the official Windows app
# instead: GTVPN_OS=Windows and GTVPN_CLIENT_VERSION=6.2.8-243.
GTVPN_OS=
GTVPN_CLIENT_VERSION=
GTVPN_FIX_OPENSSL=0

# ---- Your GT hosts -------------------------------------------------------------
# List your GT servers in hosts.conf (standard ssh config syntax), then run
# `gtvpn hosts`. Each one works as `ssh <name>` inside the container and as
# `gt-<name>` in VS Code's Remote-SSH list.
#
# Your GT username, used for GT hosts that don't set User in hosts.conf.
GTVPN_GT_USER=
# 1: on this computer, ssh and VS Code Remote-SSH reach every GT server
# (*.gatech.edu and GT's address blocks) through the container, as
# GTVPN_GT_USER unless you type user@host. 0: only the gt-<name> hosts from
# hosts.conf do. Run `gtvpn hosts` after changing it.
GTVPN_SSH_VIA_CONTAINER=1
# Older, shorter alternative to hosts.conf: space-separated alias=hostname
# pairs. Example: GTVPN_SSH_HOSTS="cadence=ece-xxx.ece.gatech.edu"
GTVPN_SSH_HOSTS=

# ---- Verification ----------------------------------------------------------------
# GT services that must be reachable through the tunnel (host:port, space
# separated) and that your host must NOT reach directly. Put your Cadence/
# Vivado server here. Example: "ece-xxx.ece.gatech.edu:22 login-ice.pace.gatech.edu:22"
GTVPN_PROBE_TARGETS=
# Names that must resolve through GT's DNS.
GTVPN_PROBE_NAMES=gatech.edu
# Optional what-is-my-IP URL used to compare host vs container egress, e.g.
# https://ifconfig.me/ip  (it must be on GTVPN_DIRECT_ALLOW to work in
# split-tunnel mode; in full-tunnel mode it is reached through GT).
GTVPN_EGRESS_URL=

# ---- Direct (non-GT) internet for Claude Code and dev tools -------------------------
# 1 = run a filtering proxy that lets the container reach ONLY these exact
# hostnames over HTTPS, directly (never through GT, even in full-tunnel).
# 0 = the container can reach nothing but GT.
GTVPN_DIRECT_EGRESS=1
# Exact hostnames, space separated. GT hostnames are always refused here.
# Claude Code needs the first line; the rest are common dev hosts.
GTVPN_DIRECT_ALLOW="api.anthropic.com claude.ai platform.claude.com console.anthropic.com statsig.anthropic.com downloads.claude.ai github.com api.github.com codeload.github.com objects.githubusercontent.com raw.githubusercontent.com registry.npmjs.org pypi.org files.pythonhosted.org"
# Extra NO_PROXY entries (comma separated, keep the trailing comma), for
# GT-side names outside *.gatech.edu that must go through the tunnel.
GTVPN_NO_PROXY_EXTRA=
# Bake Claude Code into the image (~340 MB disk; 0 to skip). Update it with
# `./gtvpn rebuild`.
GTVPN_INSTALL_CLAUDE_CODE=1
GTVPN_CLAUDE_CODE_VERSION=latest

# ---- Resources ---------------------------------------------------------------------
GTVPN_CPUS=2
GTVPN_MEMORY=2g
GTVPN_PIDS=512
# Host port for ssh / VS Code Remote-SSH into the container (127.0.0.1 only).
GTVPN_SSH_PORT=2222

# ---- Cadence through VNC (gtvpn vnc <host>) ---------------------------------------
# The viewer program, if it is not in the usual place (Windows:
# %LOCALAPPDATA%\Programs\TigerVNC or Program Files\TigerVNC; Linux:
# vncviewer on the PATH). On Windows give it as a WSL path, e.g.
# "/mnt/d/Tools/vncviewer64-1.15.0.exe".
GTVPN_VNC_VIEWER=
# Extra viewer options (docs/PERFORMANCE.md), e.g. "-FullScreen=1", or
# "-AutoSelect=0 -PreferredEncoding=Tight -QualityLevel=9" for sharper
# pictures while panning on a fast connection.
GTVPN_VNC_VIEWER_ARGS=
# Options for gtvpn's own viewer (gtvpn vnc <host> windows): "--encoding tight"
# (JPEG for photo-like areas, more data; the default zrle is lossless),
# "--compress 0" (the least server CPU, about 3x the data), "--quality 0-9"
# (Tight's JPEG).
GTVPN_VIEWER_ARGS=

# ---- Browser for the GT sign-in (empty = system default) --------------------------------
# e.g. GTVPN_BROWSER="firefox --private-window"
GTVPN_BROWSER=

# ---- Filled in by ./gtvpn setup (don't edit unless you know why) ---------------------
HOST_UID=
HOST_GID=
GTVPN_DISPLAY=
GTVPN_X11_DIR=
