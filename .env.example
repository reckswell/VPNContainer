# gtvpn settings for this computer. `./gtvpn setup` copies this to .env and
# fills in the machine-specific values (UIDs, X11 paths). Edit .env, then
# `./gtvpn up`. .env is not tracked by git; the shared settings are in
# gtvpn.toml.

# ---- VPN, SSH hosts, checks: see gtvpn.toml ---------------------------------------
# Which VPN to use and how to sign in, which SSH hosts go through the
# container, the leak-test targets and the direct-egress allow-list are in
# gtvpn.toml (part of the repo). A setting there wins over the same GTVPN_*
# line here; settings it leaves out can still be set here.
#
# Personal settings stay here, because gtvpn.toml is public on GitHub:
# Your VPN sign-in name, so you are not asked for it each time (optional).
GTVPN_USER=
# Your user name on the servers in gtvpn.toml, where a host doesn't set one.
GTVPN_GT_USER=

# Bake Claude Code into the image (~340 MB disk; 0 to skip). Update it with
# `./gtvpn rebuild`.
GTVPN_INSTALL_CLAUDE_CODE=1
GTVPN_CLAUDE_CODE_VERSION=latest

# ---- Resources ---------------------------------------------------------------------
GTVPN_CPUS=2
GTVPN_MEMORY=2g
GTVPN_PIDS=512
# Host port for ssh / VS Code Remote-SSH into the container (127.0.0.1 only).
GTVPN_SSH_PORT=2222

# ---- Browser for the GT sign-in (empty = system default) --------------------------------
# e.g. GTVPN_BROWSER="firefox --private-window"
GTVPN_BROWSER=

# ---- Filled in by ./gtvpn setup (don't edit unless you know why) ---------------------
HOST_UID=
HOST_GID=
GTVPN_DISPLAY=
GTVPN_X11_DIR=
