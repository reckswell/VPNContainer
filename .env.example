# vpncontainer settings for this computer. `./vpncontainer setup` copies this to .env and
# fills in the machine-specific values (UIDs, X11 paths). Edit .env, then
# `./vpncontainer up`. .env is not tracked by git; the shared settings are in
# vpncontainer.toml.

# ---- VPN, SSH hosts, checks: see vpncontainer.toml --------------------------------
# Which VPN to use and how to sign in, which SSH hosts go through the
# container, the leak-test targets and the direct-egress allow-list are in
# vpncontainer.toml (part of the repo). A setting there wins over the same VPNCONTAINER_*
# line here; settings it leaves out can still be set here.
#
# Personal settings stay here, because vpncontainer.toml is public on GitHub:
# Your VPN sign-in name, so you are not asked for it each time (optional).
VPNCONTAINER_USER=
# Your user name on the servers in vpncontainer.toml, where a host doesn't set one.
VPNCONTAINER_GT_USER=

# Bake Claude Code into the image (~340 MB disk; 0 to skip). Update it with
# `./vpncontainer rebuild`.
VPNCONTAINER_INSTALL_CLAUDE_CODE=1
VPNCONTAINER_CLAUDE_CODE_VERSION=latest

# ---- Resources ---------------------------------------------------------------------
VPNCONTAINER_CPUS=2
VPNCONTAINER_MEMORY=2g
VPNCONTAINER_PIDS=512
# Host port for ssh / VS Code Remote-SSH into the container (127.0.0.1 only).
VPNCONTAINER_SSH_PORT=2222

# ---- Browser for the GT sign-in (empty = system default) --------------------------------
# e.g. VPNCONTAINER_BROWSER="firefox --private-window"
VPNCONTAINER_BROWSER=

# ---- Filled in by ./vpncontainer setup (don't edit unless you know why) --------------
HOST_UID=
HOST_GID=
VPNCONTAINER_DISPLAY=
VPNCONTAINER_X11_DIR=
